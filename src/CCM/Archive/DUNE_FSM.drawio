        <mxCell id="8fZpYC_6UOeU18g5T6RQ-5" value="&lt;h1&gt;DATAFLOW_DRAINED&lt;/h1&gt;&lt;div&gt;New TriggerDecisions are not propagated to TRBs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;prestop1 command:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; &lt;/span&gt;stops DFO and DQM applications.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; &lt;/span&gt;DFO completes the requests it has already received and complete the prestop1 transition once the last TRB has been written to file (same for DQM)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; &lt;/span&gt;Dataflow is drained no remaining requests or fragments in its queues&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; &lt;/span&gt;(DFO asserts &quot;busy&quot;)&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="-630" y="380" width="390" height="180" as="geometry" />
        </mxCell>
        <mxCell id="8fZpYC_6UOeU18g5T6RQ-6" value="&lt;h1&gt;TRIGGER_SOURCES_STOPPED&lt;/h1&gt;&lt;div&gt;Trigger sources are stopped&lt;/div&gt;&lt;div&gt;Sources (TP/HSI) are stopped&lt;/div&gt;&lt;div&gt;Readout / HSI are stopped&lt;/div&gt;" style="text;html=1;strokeColor=default;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="-630" y="560" width="390" height="100" as="geometry" />
        </mxCell>
